# HTML pages: never bfcache-restore a stale page (kills the iOS "flash of the
# previous page"); always load fresh so the home shows and animates cleanly.
# Versioned assets under /assets/ keep their normal long cache.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/main
  Cache-Control: no-store
/main.html
  Cache-Control: no-store
/projects/*
  Cache-Control: no-store
